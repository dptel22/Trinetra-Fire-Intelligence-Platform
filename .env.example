# SIH 2026 PS26162 — Environment Configuration
# Copy this file to .env and fill in your values. .env is gitignored.

# === NASA FIRMS (live ingestion) ===
# Get a free Tier-1 map key: https://firms.modaps.eosdis.nasa.gov/api/area/
# NOTE: the key var the code reads is FIRMS_MAP_KEY (not FIRMS_API_KEY).
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Runtime data paths (defaults in app/core/config.py match these)
# H3_DAILY_PARQUET=data/processed/sih2026_h3_daily_features_firms.parquet
# OSMWRI_PARQUET=data/processed/sih2026_h3_daily_features_with_osm_wri.parquet
# DUCKDB_PATH=data/feature_store.duckdb
# AUDIT_DB_PATH=data/audit_log.duckdb
# INGESTION_DB_PATH=data/ingestion.duckdb
# MODEL_PATH=models/PS26162_catboost_final/inference_bundle/catboost_hotspot_classifier.cbm
# INFERENCE_BUNDLE_DIR=models/PS26162_catboost_final/inference_bundle

# H3 resolution is fixed at 8 for the served model contract.
H3_RESOLUTION=8

# Abstention: calibrated confidence floor below which a cell-day emits the
# fallback class "unclassified". Default 0.65 when unset (app/core/config.py).
# Set to off/none/false/0 to disable abstention entirely. It is never a
# trained class and no cutoff is hardcoded client-side.
# NOTE: isotonic calibration saturates this bundle's confidences (most cells
# land at 0/1), so low thresholds rarely fire in practice; the frontend shows
# the unclassified entry only when the served batch actually contains one.
# UNCLASSIFIED_THRESHOLD=0.65

# === Frontend (Vite) ===
# Dev server port and the backend base URL the SPA calls. The code reads
# VITE_API_URL and appends /api/v1/... itself — do NOT include the /api/v1
# suffix here.
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# Offline basemap: path to the PMTiles archive served from frontend/public/.
# Set this to /tiles/india.pmtiles after running the build in docs/PMTILES_BUILD.md.
# Leave empty for the dark-background fallback (map renders hexagons with no basemap).
VITE_PMTILES_URL=/tiles/india.pmtiles

# CORS: comma-separated origins allowed (overrides defaults if set).
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Ingestion tuning ===
# INGEST_MAX_BATCH_SIZE=5000