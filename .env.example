# SIH 2026 PS26162 - Environment Configuration
# Copy this file to .env and fill in your values

# NASA FIRMS API
# Get your API key from: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_API_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# Map Tile Provider (MapTiler, Mapbox, etc.)
MAP_TILE_API_KEY=
MAP_TILE_STYLE_URL=

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
ENVIRONMENT=development

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih2026
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (for caching, sessions, WebSocket pub/sub)
REDIS_URL=redis://localhost:6379/0

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws

# Offline basemap: path to the PMTiles archive served from frontend/public/.
# Set this to /tiles/india.pmtiles after running the build in docs/PMTILES_BUILD.md.
# Leave empty for the dark-background fallback (map renders hexagons with no basemap).
VITE_PMTILES_URL=/tiles/india.pmtiles

# ML Pipeline
ML_MODEL_PATH=ml-pipeline/train/model.xgb
ML_FEATURE_CONFIG=ml-pipeline/train/config.yaml
RETRAIN_SCHEDULE_CRON=0 3 * * *  # Daily at 3 AM UTC

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security (JWT for future auth)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60