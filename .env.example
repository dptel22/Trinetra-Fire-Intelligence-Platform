# SIH 2026 PS26162 — Environment Configuration
# Copy this file to .env and fill in your values. .env is gitignored.

# === NASA FIRMS (live ingestion) ===
# Get a free Tier-1 map key: https://firms.modaps.eosdis.nasa.gov/api/area/
# NOTE: the key var the code reads is FIRMS_MAP_KEY (not FIRMS_API_KEY).
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Runtime data paths (defaults in app/core/config.py match these)
# H3_DAILY_PARQUET=data/processed/sih2026_h3_daily_features_firms.parquet
# OSMWRI_PARQUET=data/processed/sih2026_h3_daily_features_with_osm_wri.parquet
# DUCKDB_PATH=data/feature_store.duckdb
# AUDIT_DB_PATH=data/audit_log.duckdb
# INGESTION_DB_PATH=data/ingestion.duckdb
# MODEL_PATH=models/PS26162_catboost_final/inference_bundle/catboost_hotspot_classifier.cbm
# INFERENCE_BUNDLE_DIR=models/PS26162_catboost_final/inference_bundle

# H3 resolution is fixed at 8 for the served model contract.
H3_RESOLUTION=8

# Optional abstention: set a numeric confidence floor to emit class "unclassified".
# Leave unset to disable abstention (never hardcode a cutoff client-side).
# UNCLASSIFIED_THRESHOLD=0.35

# === Frontend (Vite) ===
# Dev server port and the backend base URL the SPA calls.
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# CORS: comma-separated origins allowed (overrides defaults if set).
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Ingestion tuning ===
# INGEST_MAX_BATCH_SIZE=5000