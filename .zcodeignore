__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.venv-pinned/
venv-pinned/
.env
.env.local
.env.*.local
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb.json

