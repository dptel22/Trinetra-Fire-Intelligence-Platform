*.tmp
*.temp
.cache/
# PMTiles basemap build artifact (regenerate per docs/PMTILES_BUILD.md)
frontend/public/tiles/*.pmtiles
frontend/public/tiles/data/

# Playwright MCP page dumps
.playwright-mcp/
.audit_pytest_tmp/

