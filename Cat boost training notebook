ootstrap_type\": \"Bayesian\",\n","            \"loss_function\": \"MultiClass\",\n","            \"eval_metric\": \"TotalF1:average=Macro;use_weights=False\",\n","            \"auto_class_weights\": \"Balanced\",\n","            \"random_seed\": RANDOM_SEED,\n","            \"early_stopping_rounds\": EARLY_STOPPING_ROUNDS,\n","            \"verbose\": False,\n","            \"allow_writing_files\": False,\n","        }\n","\n","        model = CatBoostClassifier(**params, cat_features=cat_feats)\n","\n","        model.fit(\n","            pool_train,\n","            eval_set=pool_val,\n","            use_best_model=True,\n","        )\n","\n","        pred = model.predict(pool_val).ravel().astype(str)\n","\n","        score = f1_score(\n","            y_val_arr,\n","            pred,\n","            labels=CLASSES,\n","            average=\"macro\",\n","            zero_division=0,\n","        )\n","\n","        trial.set_user_attr(\"best_iteration\", int(model.get_best_iteration()))\n","        return float(score)\n","\n","    study_ = optuna.create_study(\n","        direction=\"maximize\",\n","        sampler=optuna.samplers.TPESampler(seed=RANDOM_SEED),\n","        study_name=study_name,\n","    )\n","\n","    # Deliberately no wall-clock timeout: the requested trial count is part of\n","    # the audit record, so a slow run must not silently return a shallower study.\n","    study_.optimize(\n","        objective,\n","        n_trials=n_trials,\n","        show_progress_bar=True,\n","    )\n","\n","    n_completed = len(study_.trials)\n","    print(f\"[{study_name}] Completed {n_completed}/{n_trials} requested trials.\")\n","    if n_completed != n_trials:\n","        raise RuntimeError(\n","            f\"{study_name}: expected exactly {n_trials} completed trials, \"\n","            f\"observed {n_completed}.\"\n","        )\n","\n","    best_params_ = study_.best_params\n","    best_iteration_ = int(\n","        study_.best_trial.user_attrs.get(\"best_iteration\", SEARCH_ITERATIONS - 1)\n","    )\n","\n","    print(f\"\\n[{study_name}] Best internal-validation Macro F1:\", f\"{study_.best_value:.4f}\")\n","    print(f\"[{study_name}] Best iteration:\", best_iteration_)\n","    print(f\"[{study_name}] Best parameters:\")\n","    print(json.dumps(best_params_, indent=2))\n","\n","    return study_, best_params_, best_iteration_\n","\n","\n","study, best_params, best_iteration = run_optuna_study(\n","    \"PS26162_CatBoost_final_internal_spatial_validation_naive\",\n","    train_pool, val_pool, y_val, cat_features,\n",")\n"]},{"cell_type":"code","execution_count":11,"id":"75d2e8a3","metadata":{"execution":{"iopub.execute_input":"2026-09-06T18:18:26.026944Z","iopub.status.busy":"2026-09-06T18:18:26.026578Z","iopub.status.idle":"2026-09-06T18:18:26.046382Z","shell.execute_reply":"2026-09-06T18:18:26.045766Z"},"papermill":{"duration":0.031774,"end_time":"2026-09-06T18:18:26.04836+00:00","exception":false,"start_time":"2026-09-06T18:18:26.016586+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["study.trials_dataframe().to_csv(\n","    OUT / \"optuna_trials.csv\",\n","    index=False,\n",")\n","\n","with open(OUT / \"best_params.json\", \"w\") as f:\n","    json.dump(\n","        {\n","            \"best_params\": best_params,\n","            \"best_iteration\": best_iteration,\n","            \"internal_validation_macro_f1\": float(study.best_value),\n","            \"validation_method\": \"deterministic_h3_parent_hash_fold\",\n","            \"validation_parent_resolution\": 6,\n","            \"validation_fold\": 0,\n","            \"feature_columns\": feature_cols,\n","            \"categorical_features\": cat_features,\n","            \"excluded_columns\": sorted(EXCLUDE_COLS),\n","        },\n","        f,\n","        indent=2,\n","    )\n"]},{"cell_type":"markdown","id":"7a955800","metadata":{"papermill":{"duration":0.009553,"end_time":"2026-09-06T18:18:26.068138+00:00","exception":false,"start_time":"2026