s\n","900:\tlearn: 0.9409946\ttotal: 15m 8s\tremaining: 9m 45s\n","1000:\tlearn: 0.9459095\ttotal: 16m 52s\tremaining: 8m 6s\n","1100:\tlearn: 0.9501549\ttotal: 18m 35s\tremaining: 6m 25s\n","1200:\tlearn: 0.9541325\ttotal: 20m 21s\tremaining: 4m 45s\n","1300:\tlearn: 0.9573989\ttotal: 22m 6s\tremaining: 3m 4s\n","1400:\tlearn: 0.9608265\ttotal: 23m 51s\tremaining: 1m 22s\n","1481:\tlearn: 0.9634206\ttotal: 25m 14s\tremaining: 0us\n","\n","TEST A (ablated, no rule-direct features) — ablated Macro F1: 0.8194\n","                   precision    recall  f1-score   support\n","\n","       industrial     0.9759    0.9895    0.9827     41957\n","           mining     0.9976    0.8255    0.9034      2498\n","agricultural_burn     0.4337    0.3613    0.3942       905\n","         wildfire     0.9980    0.9969    0.9975      3562\n","\n","         accuracy                         0.9701     48922\n","        macro avg     0.8513    0.7933    0.8194     48922\n","     weighted avg     0.9686    0.9701    0.9688     48922\n","\n","Ablated mining -- precision 0.9976 (90% CI [0.9947, 0.9993]), recall 0.8255 (90% CI [0.7549, 0.8722]), F1 0.9034 (90% CI [0.8588, 0.9307]), n=47 unique H3 cells (2498 rows)\n","\n","TEST B (ablated, no rule-direct features) — ablated Macro F1: 0.8222\n","                   precision    recall  f1-score   support\n","\n","       industrial     0.8677    0.9980    0.9283     26333\n","           mining     0.9991    0.9133    0.9542     44156\n","agricultural_burn     0.8732    0.2661    0.4079       233\n","         wildfire     0.9981    0.9984    0.9983      3766\n","\n","         accuracy                         0.9455     74488\n","        macro avg     0.9345    0.7939    0.8222     74488\n","     weighted avg     0.9522    0.9455    0.9456     74488\n","\n","Ablated mining -- precision 0.9991 (90% CI [0.9987, 0.9994]), recall 0.9133 (90% CI [0.9027, 0.9225]), F1 0.9542 (90% CI [0.9484, 0.9593]), n=342 unique H3 cells (44156 rows)\n"]}],"source":["# ---------------------------------------------------------------------------\n","# Ablation: retrain WITHOUT rule-direct features to get an unbiased read on\n","# real classification skill (not reproduction of the Phase 6 labeling rule).\n","#\n","# SELF-CORRECTION (logged, not silent): the previous version of this cell\n","# (a) reused `best_params`/`best_iteration` from the NAIVE Optuna run, which\n","# tuned hyperparameters against the full, partly-circular 52-feature set --\n","# not what spec 4.3 asks for (\"tune on the ablated feature set primarily\"),\n","# and (b) had `evaluate_ablation()` only print its results, with no return\n","# value, so the numbers could never be captured into the auto-generated\n","# summary (cell 29) -- they could only ever be hand-referenced in prose,\n","# which is the exact failure mode this rebuild was meant to eliminate.\n","# Both are fixed below: a fresh Optuna study runs on the ablated feature\n","# set, and evaluate_ablation() returns a result dict.\n","# ---------------------------------------------------------------------------\n","ablation_feature_cols = [c for c in feature_cols if c not in RULE_DIRECT_FEATURES]\n","ablation_cat_features = [c for c in cat_features if c in ablation_feature_cols]\n","\n","print(\"Ablation feature count:\", len(ablation_feature_cols),\n","      \"(dropped\", len(feature_cols) - len(ablation_feature_cols), \"rule-direct features)\")\n","\n","def make_ablation_pool(frame):\n","    part = prepare(frame)\n","    X = part[ablation_feature_cols]\n","    y = part[TARGET].astype(str)\n","    return Pool(X, y, cat_features=ablation_cat_features), y\n","\n","# Tune on the ablated feature set using the SAME internal spatial fold as\n","# the naive run (label-independent, TRAIN-states only) -- just a different\n","# feature matrix.\n","ablation_train_internal_pool, _ = make_ablation_pool(internal_train)\n","ablation_val_internal_pool, y_val_ablation = make_ablation_pool(internal_val)\n","\n","ablation_study, ablation_best_params, ablation_best_iteration = run_optuna_study(\n","    \"PS26162_CatBoost_ablation_rule_direct_removed\",\n","    ablation_train_internal_pool, ablation_val_internal_pool, y_val_ablation,\n","    ablation_cat_features,\n",")\n","\n","ablation_train_pool, _ = make_ablation_pool(full_train)\n","\n","ablation_model = CatBoostClassifier(\n","    iterations=ablation_best_iteration + 1,\n","    learning_rate=float(ablation_best_params[\"learning_rate\"]),\n","    depth=int(ablation_best_params[\"depth\"]),\n","    l2_leaf_reg=float(ablation_best_params[\"l2_leaf_reg\"]),\n","    bagging_temperature=float(ablation_best_params[\"bagging_temperature\"]),\n","    bootstrap_type=\"Bayesian\",\n","    loss_function=\"MultiClass\",\n","    eval_metric=\"TotalF1:average=Macro;use_weights=False\",\n","    auto_class_weights=\"Balanced\",\n","    random_seed=RANDOM_SEED,\n","    cat_features=ablation_cat_features,\n","    verbose=100,\n","    train_dir=str(OUT / \"ablation_catboost_info\"),\n",")\n","ablation_model.fit(ablation_train_pool, use_best_model=False)\n","\n","def evaluate_ablation(name, frame):\n","    part = prepare(frame)\n","    pool = Pool(part[ablation_feature_cols], cat_features=ablation_cat_features)\n","    pred = ablation_model.predict(pool).ravel().astype(str)\n","    y = part[TARGET].astype(str)\n","    macro = f1_score(y, pred, labels=CLASSES, average=\"macro\", zero_division=0)\n","    report = classification_report(\n","        y, pred, labels=CLASSES, digits=4, zero_division=0, output_dict=True,\n","    )\n","    print(f\"\\n{name} — ablated Macro F1: {macro:.4f}\")\n","    print(classification_report(y, pred, labels=CLASSES, digits=4, zero_division=0))\n","\n","    # ADDED (this pass): the ablated model previously had NO uncertainty\n","    # quantification at all -- only point estimates. That's backwards: the\n","    # naive model's mining metrics are trivially perfect (no real\n","    # uncertainty to report), while the ABLATED model's mining recall is\n","    # the genuinely uncertain, thin-support number (47 Test A cells) that\n","    # most needs a CI attached to it. Using the same clustered bootstrap\n","    # as the naive evaluate() for consistency.\n","    mining_metrics = bootstrap_class_metrics_ci_clustered(\n","        part, TARGET, pred, ID_COL, \"mining\", reps=1000, ci=0.90\n","    )\n","    if mining_metrics[\"n\"] > 0:\n","        print(\n","            f\"Ablated mining -- precision {mining_metrics['precision']:.4f} \"\n","            f\"(90% CI [{mining_metrics['precision_ci'][0]:.4f}, {mining_metrics['precision_ci'][1]:.4f}]), \"\n","            f\"recall {mining_metrics['recall']:.4f} \"\n","            f\"(90% CI [{mining_metrics['recall_ci'][0]:.4f}, {mining_metrics['recall_ci'][1]:.4f}]), \"\n","            f\"F1 {mining_metrics['f1']:.4f} \"\n","            f\"(90% CI [{mining_metrics['f1_ci'][0]:.4f}, {mining_metrics['f1_ci'][1]:.4f}]), \"\n","            f\"n={mining_metrics['n']} unique H3 cells ({mining_metrics['n_rows']} rows)\"\n","        )\n","        if mining_metrics[\"n\"] < MIN_TEST_CELLS:\n","            print(\n","                f\"NOTE: ablated mining support ({mining_metrics['n']} cells) is below \"\n","                f\"MIN_TEST_CELLS ({MIN_TEST_CELLS}); interpret directionally.\"\n","            )\n","\n","    return {\"macro_f1\": float(macro), \"report\": report, \"mining_metrics\": mining_metrics}\n","\n","ablation_testA_metrics = evaluate_ablation(\"TEST A (ablated, no rule-direct features)\", testA)\n","ablation_testB_metrics = evaluate_ablation(\"TEST B (ablated, no rule-direct features)\", testB)\n"]},{"cell_type":"code","execution_count":17,"id":"b1b99388","metadata":{"execution":{"iopub.execute_input":"2026-09-06T23:03:34.444397Z","iopub.status.busy":"2026-09-06T23:03:34.443576Z","iopub.status.idle":"2026-09-06T23:03:34.496502Z","shell.execute_reply":"2026-09-06T23:03:34.495505Z"},"papermill":{"duration":0.070732,"end_time":"2026-09-06