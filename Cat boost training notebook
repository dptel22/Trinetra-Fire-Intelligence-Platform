gricultural_burn  \\\n","true_industrial                   26302            0                       9   \n","true_mining                           0        44156                       0   \n","true_agricultural_burn                0            0                     233   \n","true_wildfire                         0            0                       0   \n","\n","                        pred_wildfire  \n","true_industrial                    22  \n","true_mining                         0  \n","true_agricultural_burn              0  \n","true_wildfire                    3766  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Mining -- precision 1.0000 (90% CI [1.0000, 1.0000]), recall 1.0000 (90% CI [1.0000, 1.0000]), F1 1.0000 (90% CI [1.0000, 1.0000]), n=342 unique H3 cells (44156 rows)\n"]}],"source":["def bootstrap_class_metrics_ci(y_true, y_pred, class_name, reps=2000, seed=RANDOM_SEED, ci=0.90):\n","    \"\"\"Case-resampling bootstrap CI for precision/recall/F1 of one class.\n","\n","    SELF-CORRECTION (logged, not silent): the previous version of this\n","    function (`bootstrap_class_recall_ci`) only bootstrapped recall, by\n","    resampling within the true-label subset -- and reported a 95% CI where\n","    spec 4.4 asks for 90%. That resampling scheme cannot be extended to\n","    precision, since precision depends on the predicted-positive set, not\n","    the true-positive set. This version resamples (y_true, y_pred) pairs\n","    jointly with replacement and recomputes TP/FP/FN for the class from\n","    scratch on every rep, which is the correct bootstrap for all three\n","    metrics simultaneously.\n","    \"\"\"\n","    y_true = np.asarray(y_true)\n","    y_pred = np.asarray(y_pred)\n","    n_total = len(y_true)\n","\n","    n_class_true = int((y_true == class_name).sum())\n","    if n_total == 0 or n_class_true == 0:\n","        return {\n","            \"precision\": None, \"recall\": None, \"f1\": None,\n","            \"precision_ci\": (None, None), \"recall_ci\": (None, None),\n","            \"f1_ci\": (None, None), \"n\": n_class_true,\n","            \"ci_level\": ci, \"reps\": reps,\n","        }\n","\n","    yt_bin = (y_true == class_name)\n","    yp_bin = (y_pred == class_name)\n","\n","    def _prf(tp, fp, fn):\n","        p = tp / (tp + fp) if (tp + fp) > 0 else 0.0\n","        r = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n","        f = 2 * p * r / (p + r) if (p + r) > 0 else 0.0\n","        return p, r, f\n","\n","    point_tp = int((yt_bin & yp_bin).sum())\n","    point_fp = int((~yt_bin & yp_bin).sum())\n","    point_fn = int((yt_bin & ~yp_bin).sum())\n","    point_p, point_r, point_f = _prf(point_tp, point_fp, point_fn)\n","\n","    rng = np.random.default_rng(seed)\n","    boot_p = np.empty(reps)\n","    boot_r = np.empty(reps)\n","    boot_f = np.empty(reps)\n","    for i in range(reps):\n","        idx = rng.integers(0, n_total, size=n_total)\n","        yt_i = yt_bin[idx]\n","        yp_i = yp_bin[idx]\n","        tp = int((yt_i & yp_i).sum())\n","        fp = int((~yt_i & yp_i).sum())\n","        fn = int((yt_i & ~yp_i).sum())\n","        p, r, f = _prf(tp, fp, fn)\n","        boot_p[i] = p\n","        boot_r[i] = r\n","        boot_f[i] = f\n","\n","    alpha_pct = (1 - ci) / 2 * 100\n","\n","    def _bounds(arr):\n","        return float(np.percentile(arr, alpha_pct)), float(np.percentile(arr, 100 - alpha_pct))\n","\n","    return {\n","        \"precision\": point_p, \"recall\": point_r, \"f1\": point_f,\n","        \"precision_ci\": _bounds(boot_p),\n","        \"recall_ci\": _bounds(boot_r),\n","        \"f1_ci\": _bounds(boot_f),\n","        \"n\": n_class_true, \"ci_level\": ci, \"reps\": reps,\n","    }\n","\n","def bootstrap_class_metrics_ci_clustered(frame, target_col, pred, id_col, class_name,\n","                                          reps=1000, seed=RANDOM_SEED, ci=0.90):\n","    \"\"\"Block/cluster bootstrap CI, resampling H3 cells rather than rows.\n","\n","    ADDED (this pass): the row-level bootstrap above treats every daily row\n","    as an independent sample. It is not. Mining's real Test A support is\n","    47 unique H3 cells, which expand into 2,498 correlated daily rows (the\n","    persistence rule requires >=5 active days, so each real mine\n","    contributes many rows that mostly share the same label and features).\n","    Resampling rows with replacement can effectively \"reuse\" the same\n","    handful of cells thousands of times per replicate and still look like\n","    a large-n sample -- understating true uncertainty for exactly the\n","    classes (mining, and by extension any other thin-cell-count class)\n","    where uncertainty matters most. This version resamples unique H3 cells\n","    with replacement instead, which respects the actual unit of\n","    independence in how Phase 6 labels were constructed.\n","\n","    Trade-off, disclosed: reps defaults to 1000, not 2000, because each\n","    replicate has to reassemble every resampled cell's full row block\n","    (there is no way around this cost for a correct cluster bootstrap on a\n","    frame with thousands of cells). 1000 reps is still enough for stable\n","    90% CI percentile estimates.\n","    \"\"\"\n","    y_true_col = frame[target_col].astype(str).to_numpy()\n","    y_pred_arr = np.asarray(pred).astype(str)\n","    ids = frame[id_col].to_numpy()\n","\n","    unique_ids, inverse = np.unique(ids, return_inverse=True)\n","    n_cells = len(unique_ids)\n","    cell_row_idx = [np.where(inverse == j)[0] for j in range(n_cells)]\n","\n","    n_class_true_cells = int(\n","        frame.loc[frame[target_col].astype(str) == class_name, id_col].nunique()\n","    )\n","    n_class_true_rows = int((y_true_col == class_name).sum())\n","\n","    if n_cells == 0 or n_class_true_cells == 0:\n","        return {\n","            \"precision\": None, \"recall\": None, \"f1\": None,\n","            \"precision_ci\": (None, None), \"recall_ci\": (None, None),\n","            \"f1_ci\": (None, None), \"n\": n_class_true_cells,\n","            \"n_rows\": n_class_true_rows, \"ci_level\": ci, \"reps\": reps,\n","        }\n","\n","    def _prf_from_idx(idx):\n","        yt = y_true_col[idx]\n","        yp = y_pred_arr[idx]\n","        tp = int(((yt == class_name) & (yp == class_name)).sum())\n","        fp = int(((yt != class_name) & (yp == class_name)).sum())\n","        fn = int(((yt == class_name) & (yp != class_name)).sum())\n","        p = tp / (tp + fp) if (tp + fp) > 0 else 0.0\n","        r = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n","        f = 2 * p * r / (p + r) if (p + r) > 0 else 0.0\n","        return p, r, f\n","\n","    all_idx = np.arange(len(y_true_col))\n","    point_p, point_r, point_f = _prf_from_idx(all_idx)\n","\n","    rng = np.random.default_rng(seed)\n","    boot_p = np.empty(reps)\n","    boot_r = np.empty(reps)\n","    boot_f = np.empty(reps)\n","    for i in range(reps):\n","        sampled_cells = rng.integers(0, n_cells, size=n_cells)\n","        idx = np.concatenate([cell_row_idx[j] for j in sampled_cells])\n","        p, r, f = _prf_from_idx(idx)\n","        boot_p[i] = p\n","        boot_r[i] = r\n","        boot_f[i] = f\n","\n","    alpha_pct = (1 - ci) / 2 * 100\n","\n","    def _bounds(arr):\n","        return float(np.percentile(arr, alpha_pct)), float(np.percentile(arr, 100 - alpha_pct))\n","\n","    return {\n","        \"precision\": point_p, \"recall\": point_r, \"f1\": point_f,\n","        \"precision_ci\": _bounds(boot_p),\n","        \"recall_ci\": _bounds(boot_r),\n","        \"f1_ci\": _bounds(boot_f),\n","        \"n\": n_class_true_cells, \"n_rows\": n_class_true_rows,\n","        \"ci_level\": ci, \"reps\": reps,\n","    }\n","\n","\n","\n","def evaluate(name, model, frame, include_predictions=False):\n","    part = prepare(frame)\n","    pool, y = make_pool(frame)\n","    pred = model.predict(pool).ravel().astype(str)\n","\n","    macro = f1_score(\n","        y,\n","        pred,\n","        labels=CLASSES,\n","        average=\"macro\",\n","        zero_division=0,\n","    )\n","\n","    print(\"\\n\" + \"=\" * 90)\n","    print(name)\n","    print(\"=\" * 90)\n","    print(f\"Macro F1: {macro:.4f}\")\n","    print(\n","        classification_report(\n","            y,\n","            pred,\n","            labels=CLASSES,\n","            digits=4,\n","            zero_division=0,\n","        )\n","    )\n","\n","    cm = confusion_matrix(y, pred, labels=CLASSES)\n","    cm_df = pd.DataFrame(\n","        cm,\n","        index=[f\"true_{c}\" for c in CLASSES],\n","        columns=[f\"pred_{c}\" for c in CLASSES],\n","    )\n","    print(\"Confusion matrix:\")\n","    display(cm_df)\n","\n","    # FIX (this pass): use the H3-cell-clustered bootstrap, not the plain\n","    # row-level one, for the reason documented on\n","    # bootstrap_class_metrics_ci_clustered above. Also: mining_metrics['n']\n","    # is now a CELL count, not a row count, which fixes a real bug where\n","    # the MIN_TEST_CELLS check below compared a row count (thousands) to a\n","    # cell-count floor (30) and could never actually fire for exactly the\n","    # thin-support cases it was written to catch.\n","    mining_metrics = bootstrap_class_metrics_ci_clustered(\n","        part, TARGET, pred, ID_COL, \"mining\", reps=1000, ci=0.90\n","    )\n","\n","    if mining_metrics[\"n\"] > 0:\n","        print(\n","            f\"Mining -- precision {mining_metrics['precision']:.4f} \"\n","            f\"(90% CI [{mining_metrics['precision_ci'][0]:.4f}, {mining_metrics['precision_ci'][1]:.4f}]), \"\n","            f\"recall {mining_metrics['recall']:.4f} \"\n","            f\"(90% CI [{mining_metrics['recall_ci'][0]:.4f}, {mining_metrics['recall_ci'][1]:.4f}]), \"\n","            f\"F1 {mining_metrics['f1']:.4f} \"\n","            f\"(90% CI [{mining_metrics['f1_ci'][0]:.4f}, {mining_metrics['f1_ci'][1]:.4f}]), \"\n","            f\"n={mining_metrics['n']} unique H3 cells ({mining_metrics['n_rows']} rows)\"\n","        )\n","        if mining_metrics[\"n\"] < MIN_TEST_CELLS:\n","            print(\n","                f\"NOTE: mining support ({mining_metrics['n']} cells) is below \"\n","                f\"MIN_TEST_CELLS ({MIN_TEST_CELLS}); interpret directionally.\"\n","            )\n","\n","    result = {\n","        \"macro_f1\": float(macro),\n","        \"classification_report\": classification_report(\n","            y,\n","            pred,\n","            labels=CLASSES,\n","            digits=4,\n","            zero_division=0,\n","            output_dict=True,\n","        ),\n","        \"confusion_matrix\": cm.tolist(),\n","        \"mining_metrics\": mining_metrics,\n","    }\n","\n","    if include_predictions:\n","        result[\"predictions\"] = pred.tolist()\n","        result[\"y_true\"] = y.tolist()\n","\n","    return result\n","\n","# IMPORTANT:\n","# Test A and Test B labels are first consumed here, after model selection\n","# and final refit. No test performance is used to change the model.\n","testA = labeled[labeled[STATE_COL].isin(TEST_A_STATES)].copy()\n","testB = labeled[labeled[STATE_COL].isin(TEST_B_STATES)].copy()\n","\n","train_metrics = evaluate(\n","    \"TRAIN — sanity check only\",\n","    final_model,\n","    full_train,\n",")\n","\n","testA_metrics = evaluate(\n","    \"TEST A — BLIND GEOGRAPHIC GENERALIZATION\",\n","    final_model,\n","    testA,\n","    include_predictions=True,\n",")\n","\n","testB_metrics = evaluate(\n","    \"TEST B — BLIND GEOGRAPHIC GENERALIZATION\",\n","    final_model,\n","    testB,\n","    include_predictions=True,\n",")\n"]},{"cell_type":"markdown","id":"13cae4f4","metadata":{"papermill":{"duration":0.010924,"end_time":"2026-09-06T18:26:09.375165+00:00","exception":false,"start_time":"2026-09-06T18:26:09.364241+00:00","status":"completed"},"tags":[]},"source":["## Ablation: rule-direct feature removal\n","\n","The 