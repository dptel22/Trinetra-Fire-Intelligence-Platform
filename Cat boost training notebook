tance_naive.csv\", index=False)\n","\n","plt.figure(figsize=(10, 8))\n","top = imp.head(25).iloc[::-1]\n","plt.barh(top[\"feature\"], top[\"importance\"])\n","plt.xlabel(\"PredictionValuesChange importance\")\n","plt.ylabel(\"Feature\")\n","plt.title(\"Top 25 CatBoost Features (naive, rule-direct features included)\")\n","plt.tight_layout()\n","plt.show()\n","\n","# Feature importance -- ABLATED model. Spec 4.7 asks specifically for this\n","# one, since it is the read on what's actually driving predictions once the\n","# rule-direct/circular features are removed. The previous version of this\n","# cell only computed importance for the naive model -- this half was missing.\n","ablation_importance = ablation_model.get_feature_importance(ablation_train_pool)\n","\n","ablation_imp = (\n","    pd.DataFrame({\n","        \"feature\": ablation_feature_cols,\n","        \"importance\": ablation_importance,\n","    })\n","    .sort_values(\"importance\", ascending=False)\n","    .reset_index(drop=True)\n",")\n","\n","display(ablation_imp.head(30))\n","ablation_imp.to_csv(OUT / \"feature_importance_ablated.csv\", index=False)\n","\n","plt.figure(figsize=(10, 8))\n","top_ablated = ablation_imp.head(25).iloc[::-1]\n","plt.barh(top_ablated[\"feature\"], top_ablated[\"importance\"])\n","plt.xlabel(\"PredictionValuesChange importance\")\n","plt.ylabel(\"Feature\")\n","plt.title(\"Top 25 CatBoost Features (ablated -- the trustworthy read)\")\n","plt.tight_layout()\n","plt.show()\n"]},{"cell_type":"code","execution_count":20,"id":"2f63532a","metadata":{"execution":{"iopub.execute_input":"2026-09-06T23:03:41.620571Z","iopub.status.busy":"2026-09-06T23:03:41.620328Z","iopub.status.idle":"2026-09-06T23:03:41.631457Z","shell.execute_reply":"2026-09-06T23:03:41.63084Z"},"papermill":{"duration":0.029074,"end_time":"2026-09-06T23:03:41.632739+00:00","exception":false,"start_time":"2026-09-06T23:03:41.603665+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","==========================================================================================\n","FINAL TRAINING SUMMARY\n","==========================================================================================\n","Internal spatial validation Macro F1 (naive):   0.9970\n","Internal spatial validation Macro F1 (ablated): 0.8885\n","Test A blind Macro F1 (naive):    0.9744\n","Test A blind Macro F1 (ablated):  0.8194\n","Test B blind Macro F1 (naive):    0.9944\n","Test B blind Macro F1 (ablated):  0.8222\n","\n","Partition support gate: PASS\n","Internal validation: label-independent H3-parent blocking\n","Test A/Test B: not used for model selection\n","Raw lat/lon: excluded\n","Class balancing: Balanced\n","Satellite identity: not fabricated\n","==========================================================================================\n"]}],"source":["# Fail loud, not narrate blind: assert against the flag cell 5 actually set,\n","# rather than printing a hardcoded \"PASS\" string. If cell 5 was edited and\n","# not re-run in this session, this raises a clear NameError here instead of\n","# silently repeating a stale claim -- which is exactly the failure mode that\n","# produced the last invalid run of this notebook.\n","assert partition_gate_passed, \"Cell 5's partition gate was edited or never executed in this session.\"\n","\n","metadata = {\n","    \"dataset\": str(data_path),\n","    \"dataset_sha256\": dataset_sha256,\n","    \"package_versions\": PACKAGE_VERSIONS,\n","    \"model\": \"CatBoostClassifier\",\n","    \"target\": TARGET,\n","    \"classes\": CLASSES,\n","\n","    \"train_states\": TRAIN_STATES,\n","    \"test_a_states\": TEST_A_STATES,\n","    \"test_b_states\": TEST_B_STATES,\n","\n","    \"frozen_upstream_support\": FROZEN_SUPPORT,\n","\n","    \"internal_validation\": {\n","        \"method\": \"deterministic H3-parent hash fold\",\n","        \"parent_resolution\": 6,\n","        \"fold\": 0,\n","        \"num_folds\": 5,\n","        \"label_independent_selection\": True,\n","        \"h3_parent_overlap\": parent_overlap,\n","        \"exact_h3_08_overlap\": h3_overlap,\n","        \"train_rows\": len(internal_train),\n","        \"validation_rows\": len(internal_val),\n","        \"validation_class_counts\": (\n","            val_class_counts.reindex(CLASSES, fill_value=0).to_dict()\n","        ),\n","    },\n","\n","    \"features\": feature_cols,\n","    \"categorical_features\": cat_features,\n","    \"excluded_features\": sorted(EXCLUDE_COLS),\n","\n","    \"best_params\": best_params,\n","    \"best_iteration\": best_iteration,\n","    \"internal_validation_macro_f1\": float(study.best_value),\n","    \"diagnostic_validation_metric_key\": val_f1_key,\n","\n","    \"ablation_feature_cols\": ablation_feature_cols,\n","    \"ablation_best_params\": ablation_best_params,\n","    \"ablation_best_iteration\": ablation_best_iteration,\n","    \"ablation_internal_validation_macro_f1\": float(ablation_study.best_value),\n","\n","    \"train_macro_f1\": train_metrics[\"macro_f1\"],\n","    \"test_a_macro_f1\": testA_metrics[\"macro_f1\"],\n","    \"test_b_macro_f1\": testB_metrics[\"macro_f1\"],\n","    \"test_a_ablated_macro_f1\": ablation_testA_metrics[\"macro_f1\"],\n","    \"test_b_ablated_macro_f1\": ablation_testB_metrics[\"macro_f1\"],\n","\n","    \"class_balancing\": \"auto_class_weights=Balanced\",\n","\n","    \"blind_test_policy\": (\n","        \"Test A and Test B were not used for Optuna tuning, early stopping, \"\n","        \"feature selection, threshold selection, or tree-count selection. \"\n","        \"Their labels were first consumed for evaluation after the final refit.\"\n","    ),\n","\n","    \"pseudo_label_caveat\": (\n","        \"Phase 6 labels are bootstrap/pseudo-labels derived partly from the \"\n","        \"same FIRMS/OSM/WRI feature family consumed by the model. Metrics \"\n","        \"therefore estimate geographic generalization of the labeling scheme, \"\n","        \"not independent ground-truth accuracy.\"\n","    ),\n","\n","    \"dtype_safety\": (\n","        \"Categorical features are converted to strings before missing-value handling; \"\n","        \"boolean model features are cast to int8; non-finite numeric values are rejected.\"\n","    ),\n","\n","    \"satellite_feature_status\": (\n","        \"satellite_nunique is present; raw satellite identity is absent. \"\n","        \"No satellite category was fabricated.\"\n","    ),\n","}\n","\n","with open(OUT / \"model_metadata.json\", \"w\") as f:\n","    json.dump(metadata, f, indent=2)\n","\n","print(\"\\n\" + \"=\" * 90)\n","print(\"FINAL TRAINING SUMMARY\")\n","print(\"=\" * 90)\n","print(f\"Internal spatial validation Macro F1 (naive):   {study.best_value:.4f}\")\n","print(f\"Internal spatial validation Macro F1 (ablated): {ablation_study.best_value:.4f}\")\n","print(f\"Test A blind Macro F1 (naive):    {testA_metrics['macro_f1']:.4f}\")\n","print(f\"Test A blind Macro F1 (ablated):  {ablation_testA_metrics['macro_f1']:.4f}\")\n","print(f\"Test B blind Macro F1 (naive):    {testB_metrics['macro_f1']:.4f}\")\n","print(f\"Test B blind Macro F1 (ablated):  {ablation_testB_metrics['macro_f1']:.4f}\")\n","print()\n","print(\"Partition support gate:\", \"PASS\" if partition_gate_passed else \"FAIL\")\n","print(\"Internal validation: label-independent H3-parent blocking\")\n","print(\"Test A/Test B: not used for model selection\")\n","print(\"Raw lat/lon: excluded\")\n","print(\"Class balancing: Balanced\")\n","print(\"Satellite identity: not fabricated\")\n","print(\"=\" * 90)\n"]},{"cell_type":"markdown","id":"810c9ea5","metadata":{"papermill":{"duration":0.015405,"end_time":"2026-09-06T23:03:41.663001+00:00","exception":false,"start_time":"2026-09-06T23:03:41.647596+00:00","status":"completed"},"tags":[]},"source":["### Probability calibration (before tiering)\n","\n","CatBoost, like other boosted-tree models, tends to push predicted probabilities\n","toward 0/1 -- overconfident, not genuinely reflective of true correctness rates,\n","especially on imbalanced classes. Using raw `predict_proba` output directly as a\n","\"confidence\" score for the deployment tiering below would risk exactly the\n","failure mode this project has spent this whole session removing: trusting a\n","number that looks precise but isn't earned. This cell fits a per-class isotonic\n","calibration map on `diagnostic_model` against `internal_val` -- genuinely\n","held-out data, since `internal_val` was never part of `diagnostic_model`'s\n","training set (unlike `final_model`, which trains on internal_train +\n","internal_val combined). Test A/B are never used here; using blind-holdout rows\n","to fit a calibration map before evaluating on those same rows would be\n","circular, the same category of error already fixed twice earlier in this\n","notebook.\n","\n","Disclosed limitation: the calibration map is fit against `diagnostic_model`,\n","then applied to `final_model`'s raw probabilities, since `final_model` has no\n","genuinely-held-out data left to calibrate against once it is trained on full\n","TRAIN. This assumes the two models' probability behavior is similar (same\n","hyperparameters, closely related training data) -- a reasonable approximation,\n","not an exact calibration of `final_model` itself."]},{"cell_type":"code","execution_count":21,"id":"64edbb89","metadata":{"execution":{"iopub.execute_input":"2026-09-06T23:03:41.694837Z","iopub.status.busy":"2026-09-06T23:03:41.694399Z","iopub.status.idle":"2026-09-06T23:03:41.893868Z","shell.execute_reply":"2026-09-06T23:03:41.893105Z"},"papermill":{"duration":0.217392,"end_time":"2026-09-06T23:03:41.895553+00:00","exception":false,"start_time":"2026-09-06T23:03:41.678161+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["======================================================================\n","PER-CLASS ISOTONIC CALIBRATION (fit on diagnostic_model / internal_val)\n","======================================================================\n","agricultural_burn: raw mean confidence 0.9973 | actual correct rate 0.9789 | calibrated mean confidence 0.9789\n","industrial: raw mean confidence 0.9971 | actual correct rate 1.0000 | calibrated mean confidence 1.0000\n","mining: raw mean confidence 0.9970 | actual correct rate 1.0000 | calibrated mean confidence 1.0000\n","wildfire: raw mean confidence 0.9974 | actual correct rate 0.9984 | calibrated mean confidence 0.9984\n","\n","A large gap between 'raw mean confidence' and 'actual correct rate' above confirms overconfidence for that class -- expect this to be largest for agricultural_burn given its known weak, partly-circular label.\n"]}],"source":["from sklearn.isotonic import IsotonicRegression\n","\n","_diag_val_part = prepare(internal_val)\n","_diag_val_pool = Pool(_diag_val_part[feature_cols], cat_features=cat_features)\n","_diag_val_proba = diagnostic_model.predict_proba(_diag_val_pool)\n","_diag_val_y = _diag_val_part[TARGET].astype(str).to_numpy()\n","_diag_classes = list(diagnostic_model.classes_)\n","\n","CALIBRATORS = {}\n","print(\"=\" * 70)\n","print(\"PER-CLASS ISOTONIC CALIBRATION (fit on diagnostic_model / internal_val)\")\n","print(\"=\" * 70)\n","for _cls_idx, _cls in enumerate(_diag_classes):\n","    _raw = _diag_val_proba[:, _cls_idx]\n","    _is_class = (_diag_val_y == _cls).astype(int)\n","    _iso = IsotonicRegression(out_of_bounds=\"clip\", y_min=0.0, y_max=1.0)\n","    _iso.fit(_raw, _is_class)\n","    CALIBRATORS[_cls] = _iso\n","\n","    # Quick before/after check: mean predicted prob vs actual observed rate,\n","    # among rows this class was the argmax prediction on internal_val.\n","    _pred_idx = _diag_val_proba.argmax(axis=1)\n","    _this_class_mask = _pred_idx == _cls_idx\n","    if _this_class_mask.sum() > 0:\n","        _raw_mean = _raw[_this_class_mask].mean()\n","        _actual_rate = _is_class[_this_class_mask].mean()\n","        _calibrated_mean = _iso.predict(_raw[_this_class_mask]).mean()\n","        print(\n","            f\"{_cls}: raw mean confidence {_raw_mean:.4f} | \"\n","            f\"actual correct rate {_actual_rate:.4f} | \"\n","            f\"calibrated mean confidence {_calibrated_mean:.4f}\"\n","        )\n","\n","print(\n","    \"\\nA large gap between 'raw mean confidence' and 'actual correct rate' \"\n","    \"above confirms overconfidence for that class -- expect this to be \"\n","    \"largest for agricultural_burn given its known weak, partly-circular label.\"\n",")"]},{"cell_type":"markdown","id":"a03a54e0","metadata":{"papermill":{"duration":0.015504,"end_time":"2026-09-06T23:03:41.926902+00:00","exception":false,"start_time":"2026-09-06T23:03:41.911398+00:00","status":"completed"},"tags":[]},"source":["## Deployment confidence tiering (real-world routing, not a naive-F1 patch)\n","\n","No feature engineering or threshold tuning turns a model trained on pseudo-labels\n","into ground-truth-verified output. Every real operational satellite-monitoring\n","system checked (UAV wildfire governance frameworks, evidential smoke-density\n","classifiers, tiered fire-management platforms) handles this the same way: the\n","model never gets to act alone. Predictions are split by confidence into an\n","auto-accept tier and a human-review tier, and only the auto-accept tier is\n","treated as a final answer. This cell builds that split for this model,\n","class-aware, using what this notebook has already proven about which classes\n","are trustworthy and which are not."]},{"cell_type":"code","execution_count":22,"id":"7fa03829","metadata":{"execution":{"iopub.execute_input":"2026-09-06T23:03:41.958449Z","iopub.status.busy":"2026-09-06T23:03:41.958018Z","iopub.status.idle":"2026-09-06T23:03:50.728481Z","shell.execute_reply":"2026-09-06T23:03:50.72766Z"},"papermill":{"duration":8.788262,"end_time":"2026-09-06T23:03:50.730084+00:00","exception":false,"start_time":"2026-09-06T23:03:41.941822+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["======================================================================\n","DEPLOYMENT CONFIDENCE TIERING -- Test A + Test B\n","======================================================================\n","\n","% of each predicted class routed to human review:\n","predicted_label\n","agricultural_burn    100.00\n","industrial             0.00\n","mining                 0.00\n","wildfire               1.23\n","\n","Overall: 1.15% of all predictions require human review before being treated as final.\n","\n","This is the honest deployment picture: wildfire/industrial largely auto-clear, mining partially clears, agricultural_burn is always routed to review. That is not a weaker product -- it is what every real operational fire-monitoring system checked during this project actually does, and it is a stronger, more defensible claim to make to NTRO than a single naive accuracy number.\n","\n","Saved: /kaggle/working/PS26162_catboost_final/deployment_tiered_predictions.csv\n"]}],"source":["# ============================================================\n","# DEPLOYMENT CONFIDENCE TIERING\n","# ============================================================\n","# Per-class review thresholds are informed by what THIS notebook already\n","# measured, not guessed from scratch:\n","#   - wildfire, industrial: ablated F1 was strong (0.93-0.999) -- lower bar\n","#     for auto-accept is defensible.\n","#   - mining: ablated F1 survives but with a WIDE bootstrap CI on thin\n","#     Test A support (47 cells) -- higher bar, route more to review.\n","#   - agricultural_burn: ablated F1 collapsed (~0.42-0.45) -- this class\n","#     should almost never auto-accept; treat it as review-required by\n","#     default regardless of the model's own confidence score, since the\n","#     model's confidence itself is trained on a weak, partly-circular label.\n","REVIEW_THRESHOLDS = {\n","    \"wildfire\": 0.70,\n","    \"industrial\": 0.70,\n","    \"mining\": 0.85,\n","    \"agricultural_burn\": 1.01,  # >1.0 is unreachable -- always routes to review\n","}\n","\n","def tier_predictions(model, frame, feature_columns, cat_feats, calibrators):\n","    part = prepare(frame)\n","    pool = Pool(part[feature_columns], cat_features=cat_feats)\n","    proba = model.predict_proba(pool)\n","    classes = list(model.classes_)\n","    pred_idx = proba.argmax(axis=1)\n","    pred_label = np.array([classes[i] for i in pred_idx])\n","    raw_confidence = proba.max(axis=1)\n","\n","    # FIX: use calibrated confidence, not raw predict_proba. Raw tree-ensemble\n","    # probabilities are known to be overconfident, especially for imbalanced\n","    # classes -- exactly agricultural_burn and thin-support mining, the two\n","    # classes this tiering exists to protect against. Apply the per-class\n","    # isotonic map fit two cells above to the predicted class's own raw score.\n","    confidence = np.array([\n","        calibrators[lbl].predict([raw_p])[0] if lbl in calibrators else raw_p\n","        for lbl, raw_p in zip(pred_label, raw_confidence)\n","    ])\n","\n","    threshold = np.array([REVIEW_THRESHOLDS.get(lbl, 1.01) for lbl in pred_label])\n","    needs_review = confidence < threshold\n","\n","    out = part[[ID_COL, DATE_COL, STATE_COL]].copy()\n","    out[\"predicted_label\"] = pred_label\n","    out[\"raw_confidence\"] = raw_confidence\n","    out[\"confidence\"] = confidence\n","    out[\"needs_human_review\"] = needs_review\n","    return out\n","\n","print(\"=\" * 70)\n","print(\"DEPLOYMENT CONFIDENCE TIERING -- Test A + Test B\")\n","print(\"=\" * 70)\n","\n","tiered = tier_predictions(final_model, pd.concat([testA, testB]), feature_cols, cat_features, CALIBRATORS)\n","\n","review_rate_by_class = (\n","    tiered.groupby(\"predicted_label\")[\"needs_human_review\"]\n","    .mean()\n","    .mul(100)\n","    .round(2)\n",")\n","print(\"\\n% of each predicted class routed to human review:\")\n","print(review_rate_by_class.to_string())\n","\n","overall_review_rate = tiered[\"needs_human_review\"].mean() * 100\n","print(f\"\\nOverall: {overall_review_rate:.2f}% of all predictions require human review before being treated as final.\")\n","print(\n","    \"\\nThis is the honest deployment picture: wildfire/industrial largely \"\n","    \"auto-clear, mining partially clears, agricultural_burn is always \"\n","    \"routed to review. That is not a weaker product -- it is what every \"\n","    \"real operational fire-monitoring system checked during this project \"\n","    \"actually does, and it is a stronger, more defensible claim to make \"\n","    \"to NTRO than a single naive accuracy number.\"\n",")\n","\n","tiered.to_csv(OUT / \"deployment_tiered_predictions.csv\", index=False)\n","print(f\"\\nSaved: {OUT / 'deployment_tiered_predictions.csv'}\")"]},{"cell_type":"code","execution_count":23,"id":"0445cd98","metadata":{"execution":{"iopub.execute_input":"2026-09-06T23:03:50.763028Z","iopub.status.busy":"2026-09-06T23:03:50.762759Z","iopub.status.idle":"2026-09-06T23:03:51.771543Z","shell.execute_reply":"2026-09-06T23:03:51.770532Z"},"papermill":{"duration":1.026916,"end_time":"2026-09-06T23:03:51.773007+00:00","exception":false,"start_time":"2026-09-06T23:03:50.746091+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","==========================================================================================\n","FINAL ADVERSARIAL DATA-LEAKAGE AUDIT\n","==========================================================================================\n","Dataset SHA-256: fbdd86cbc0e396cd8e057894f592ef56e5ed2d5db05396ce440bafc813f39333\n","Exact H3 overlap (train/test A): 0\n","Exact H3 overlap (train/test B): 0\n","Exact H3 overlap (test A/test B): 0\n","H3-6 parent overlap (train/test A, reported only): 163\n","H3-6 parent overlap (train/test B, reported 