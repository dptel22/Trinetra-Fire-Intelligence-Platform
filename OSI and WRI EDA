_08\"].nunique()\n","\n","records = []\n","for state, g in df_daily.groupby(\"state\"):\n","    records.append({\n","        \"state\": state,\n","        \"n_h3_days\": len(g),\n","        \"n_unique_cells\": g[\"h3_08\"].nunique(),\n","        \"industrial_cells\": unique_cells_within(g, \"dist_osm_industrial_km\", 5),\n","        \"quarry_cells\": unique_cells_within(g, \"dist_osm_quarry_km\", 5),\n","        \"farmland_cells\": unique_cells_within(g, \"dist_osm_farmland_km\", 5),\n","        \"power_infra_cells\": unique_cells_within(g, \"dist_osm_power_infra_km\", 5),\n","    })\n","state_summary = pd.DataFrame(records)\n","\n","# every WRI fuel column that actually got created earlier — unique cells, not rows\n","wri_cols = [c for c in df_daily.columns if c.startswith(\"n_wri_\") and c.endswith(\"_10km\")]\n","for col in wri_cols:\n","    name = col.replace(\"n_wri_\", \"wri_\").replace(\"_10km\", \"\")\n","    per_state = df_daily.groupby(\"state\").apply(lambda g, c=col: g.loc[g[c] > 0, \"h3_08\"].nunique())\n","    state_summary[name] = state_summary[\"state\"].map(per_state)\n","\n","flare_by_state = flare_candidates.groupby(\"state\")[\"h3_08\"].nunique().rename(\"flare_candidate_cells\")\n","flare_confirmed_by_state = flare_confirmed.groupby(\"state\")[\"h3_08\"].nunique().rename(\"flare_confirmed_cells\")\n","state_summary = state_summary.merge(flare_by_state, on=\"state\", how=\"left\").fillna({\"flare_candidate_cells\": 0})\n","state_summary = state_summary.merge(flare_confirmed_by_state, on=\"state\", how=\"left\").fillna({\"flare_confirmed_cells\": 0})\n","\n","pd.set_option(\"display.max_rows\", None)\n","pd.set_option(\"display.width\", None)\n","print(state_summary.sort_values(\"n_unique_cells\", ascending=False).to_string(index=False))\n","\n","state_summary.to_csv(\"/kaggle/working/state_evidence_table.csv\", index=False)\n","print(\"\\nSaved: /kaggle/working/state_evidence_table.csv\")"]},{"cell_type":"code","execution_count":13,"id":"75130516