ception":false,"start_time":"2026-08-31T07:35:17.123396+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["\"\"\"\n","PS26162 — Phase 6: Multi-class label bootstrap (4 trained classes)\n","\n","FIX vs. prior version: farmland proximity was checked BEFORE FRP intensity,\n","so an intense wildfire near a farm field got mislabeled agricultural_burn\n","purely by rule order. This version checks intensity/suddenness FIRST.\n","\n","Output: 4 trained classes only — industrial, mining, agricultural_burn, wildfire.\n","'unclassified' is NOT assigned here. It's a post-training confidence-threshold\n","fallback applied to model *probabilities*, not a bootstrap label. Rows that\n","don't clearly satisfy any rule are left unlabeled (is_labeled=0) and excluded\n","from Phase 6 training data — they are NOT dumped into 'unclassified'.\n","\n","RUN THIS: as new cells appended to the END of osi-wri-data.ipynb, after Cell 21.\n","Reuse the `df_daily` already in memory there (52-col merged table) — do not\n","reload from disk, do not create a separate notebook. Column names below are\n","confirmed directly from your osi-wri-data.ipynb source (Cells 9, 15, 19), not\n","guessed.\n","\"\"\"\n","\n","import pandas as pd\n","import numpy as np\n","\n","CONFIG = {\n","    # Core Phase 9 columns — confirmed, from data-eda.ipynb output\n","    \"frp_max\": \"frp_max\",\n","    \"n_detections\": \"n_detections\",\n","    \"is_saturated_max\": \"is_saturated_max\",\n","    \"active_days_90d\": \"active_days_90d\",\n","    \"is_first_observation\": \"is_first_observation\",\n","    \"is_offshore\": \"is_offshore\",\n","\n","    # OSM enrichment — confirmed, from osi-wri-data.ipynb Cell 15 CATEGORY_TAGS\n","    \"dist_osm_industrial_km\": \"dist_osm_industrial_km\",  # landuse=industrial\n","    \"dist_osm_quarry_km\": \"dist_osm_quarry_km\",          # landuse=quarry\n","    \"dist_osm_mineshaft_km\": \"dist_osm_mineshaft_km\",    # man_made=mineshaft\n","    \"dist_osm_adit_km\": \"dist_osm_adit_km\",              # man_made=adit\n","    \"dist_osm_farmland_km\": \"dist_osm_farmland_km\",      # landuse=farmland\n","    \"dist_osm_power_infra_km\": \"dist_osm_power_infra_km\",  # power=plant/substation/generator\n","\n","    # WRI enrichment — confirmed, exact names used in your own Cell 19 flare rule\n","    \"dist_wri_gas_km\": \"dist_wri_gas_km\",\n","    \"dist_wri_oil_km\": \"dist_wri_oil_km\",\n","\n","    # Proximity thresholds — 5km matches the convention already used\n","    # throughout osi-wri-data.ipynb (state_summary's <5 checks, flare rule's\n","    # WRI confirmation). farmland_proximity_km is NOT in any of your notebooks\n","    # — still a placeholder guess, needs your judgment or a quick sensitivity\n","    # check like the flare threshold sweep you already did for gas flares.\n","    \"industrial_proximity_km\": 5.0,\n","    \"farmland_proximity_km\": 1.0,   # STILL A GUESS — not derived anywhere\n","    \"mining_persistence_days\": 5,   # DERIVED — Phase 6c calibration (2026-08-30):\n","                                     # tight distances (median 2.57km), smooth\n","                                     # day-decay (no boundary artifact at >=5),\n","                                     # real frp signal, both GJ+TN represented.\n","                                     # National blast radius: +9,724 rows (~10%).\n","                                     # Was 10 (unvalidated placeholder).\n","}\n","\n","\n","def derive_wildfire_frp_cutoff(df, cfg, near_farmland_mask):\n","    \"\"\"\n","    Data-driven cutoff, NOT a guessed number.\n","\n","    Logic: compare frp_max distribution for detections NOT near farmland\n","    (these are FRP-confirmed non-agricultural high-intensity events by\n","    definition — nothing else nearby to confound the signal) against\n","    detections near farmland. The cutoff is the point where \"near farmland\"\n","    detections start looking like the tail of the \"not near farmland\"\n","    distribution rather than its bulk — i.e. the 90th percentile of the\n","    NOT-near-farmland distribution. Anything above that, even near farmland,\n","    is intense enough to not plausibly be routine stubble/crop burning.\n","\n","    Print diagnostics so you can eyeball whether this generalizes before\n","    trusting it — this is exactly the groupby check flagged as still needed.\n","    \"\"\"\n","    frp = df[cfg[\"frp_max\"]]\n","    not_near = frp[~near_farmland_mask]\n","    near = frp[near_farmland_mask]\n","\n","    print(\"=\" * 70)\n","    print(\"FRP_MAX DISTRIBUTION: near-farmland vs not-near-farmland\")\n","    print(\"=\" * 70)\n","    print(\"\\nNOT near farmland (n={:,}):\".format(len(not_near)))\n","    print(not_near.describe(percentiles=[.5, .75, .90, .95, .99]))\n","    print(\"\\nNear farmland (n={:,}):\".format(len(near)))\n","    print(near.describe(percentiles=[.5, .75, .90, .95, .99]))\n","\n","    cutoff = not_near.quantile(0.90)\n","    pct_near_above_cutoff = (near > cutoff).mean() * 100\n","\n","    print(f\"\\nDerived cutoff (90th pct of not-near-farmland frp_max): {cutoff:.2f}\")\n","    print(f\"% of near-farmland detections above this cutoff: {pct_near_above_cutoff:.2f}%\")\n","    print(\n","        \"\\nSANITY CHECK: if this % is very high (>20%), the cutoff isn't \"\n","        \"discriminating — farmland fires routinely reach this intensity, and \"\n","        \"you need a different signal (e.g. detection suddenness / duration) \"\n","        \"rather than raw FRP magnitude alone. Inspect before trusting.\"\n","    )\n","    return cutoff\n","\n","\n","def bootstrap_labels(df, cfg):\n","    df = df.copy()\n","    near_farmland = df[cfg[\"dist_osm_farmland_km\"]] <= cfg[\"farmland_proximity_km\"]\n","\n","    wildfire_frp_cutoff = derive_wildfire_frp_cutoff(df, cfg, near_farmland)\n","\n","    label = pd.Series(pd.NA, index=df.index, dtype=\"object\")\n","\n","    # --- Rule order (fixed): intensity/suddenness FIRST, farmland LAST ---\n","\n","    # 1. WILDFIRE — high intensity + first/sudden appearance, regardless of\n","    #    farmland proximity. This is the fix: a genuine intense fire near a\n","    #    field wins the tiebreak here, before rule 4 ever gets to check it.\n","    is_wildfire = (\n","        (df[cfg[\"frp_max\"]] >= wildfire_frp_cutoff)\n","        & (df[cfg[\"is_first_observation\"]] == 1)\n","        & (df[cfg[\"is_offshore\"]] != 1)\n","    )\n","    label[is_wildfire] = \"wildfire\"\n","\n","    # 2. MINING — near OSM quarry, mineshaft, or adit (min distance across\n","    #    all three), persistent (not a one-off)\n","    dist_mining = df[[cfg[\"dist_osm_quarry_km\"], cfg[\"dist_osm_mineshaft_km\"],\n","                       cfg[\"dist_osm_adit_km\"]]].min(axis=1)\n","    is_mining = (\n","        label.isna()\n","        & (dist_mining <= cfg[\"industrial_proximity_km\"])\n","        & (df[cfg[\"active_days_90d\"]] >= cfg[\"mining_persistence_days\"])  # 5, data-derived\n","    )\n","    label[is_mining] = \"mining\"\n","\n","    # 3. AGRICULTURAL_BURN — narrow, specific condition (farmland proximity\n","    #    only). Checked BEFORE industrial's broad catch-all, same logic as\n","    #    the wildfire fix: narrow rules win before broad ones. Confirmed via\n","    #    diagnostic: 62.3% of legitimate near-farmland candidates were being\n","    #    claimed by industrial's loose OR-condition before this ever ran.\n","    is_agri = label.isna() & (df[cfg[\"dist_osm_farmland_km\"]] <= cfg[\"farmland_proximity_km\"])\n","    label[is_agri] = \"agricultural_burn\"\n","\n","    # 4. INDUSTRIAL — the broad catch-all, checked LAST among non-wildfire\n","    #    rules on purpose. Saturated+persistent (gas-flare-style proxy,\n","    #    folded in per locked decision) OR near OSM industrial polygon/power\n","    #    infra OR near WRI gas/oil facility (exact rule from your Cell 19)\n","    is_industrial = (\n","        label.isna()\n","        & (\n","            ((df[cfg[\"is_saturated_max\"]] == 1) & (df[cfg[\"active_days_90d\"]] >= 60))\n","            | (df[cfg[\"dist_osm_industrial_km\"]] <= cfg[\"industrial_proximity_km\"])\n","            | (df[cfg[\"dist_osm_power_infra_km\"]] <= cfg[\"industrial_proximity_km\"])\n","            | (df[cfg[\"dist_wri_gas_km\"]] <= 5.0)\n","            | (df[cfg[\"dist_wri_oil_km\"]] <= 5.0)\n","        )\n","    )\n","    label[is_industrial] = \"industrial\"\n","\n","    df[\"label\"] = label\n","    df[\"is_labeled\"] = label.notna().astype(\"int8\")\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"LABEL DISTRIBUTION (4 trained classes)\")\n","    print(\"=\" * 70)\n","    print(df[\"label\"].value_counts(dropna=False))\n","    print(f\"\\nUnlabeled rows (excluded from training, NOT 'unclassified'): \"\n","          f\"{(~df['is_labeled'].astype(bool)).sum():,} \"\n","          f\"({(~df['is_labeled'].astype(bool)).mean()*100:.2f}%)\")\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"SUPPORT CHECK — need >=100 train cells / >=30 test cells per class\")\n","    print(\"=\" * 70)\n","    print(df.loc[df[\"is_labeled\"] == 1, \"label\"].value_counts())\n","\n","    return df\n","\n","\n","if __name__ == \"__main__\":\n","    # Add this as new cells at the END of osi-wri-data.ipynb, after Cell 21.\n","    # `df_daily` is already the merged 52-col table in memory at that point —\n","    # do not reload from disk, do not create a separate notebook.\n","    #\n","    # df_labeled = bootstrap_labels(df_daily, CONFIG)\n","    # df_labeled.to_parquet(\"/kaggle/working/sih2026_h3_daily_labeled.parquet\", index=False)\n","    #\n","    # Fresh-session fallback only, if you ever run this separately:\n","    # df_daily = pd.read_parquet(\"/kaggle/working/sih2026_h3_daily_features_with_osm_wri.parquet\")\n","    pass"]},{"cell_type":"code","execution_count":17,"id":"3b966013","metadata":{"execution":{"iopub.execute_input":"2026-08-31T07:35:17.180795Z","iopub.status.busy":"2026-08-31T07:35