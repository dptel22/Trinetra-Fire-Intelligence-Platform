ck=True)\n","\n","osm_raw = gpd.read_file(GEOJSON_OUT)\n","print(f\"Filtered OSM features (nationwide): {len(osm_raw):,}\")"]},{"cell_type":"markdown","id":"7cfce235","metadata":{"papermill":{"duration":0.009056,"end_time":"2026-09-06T16:44:19.67187+00:00","exception":false,"start_time":"2026-09-06T16:44:19.662814+00:00","status":"completed"},"tags":[]},"source":["# OSM category distances/counts"]},{"cell_type":"code","execution_count":9,"id":"6e76190d","metadata":{"execution":{"iopub.execute_input":"2026-09-06T16:44:19.691755Z","iopub.status.busy":"2026-09-06T16:44:19.69143Z","iopub.status.idle":"2026-09-06T16:45:03.704324Z","shell.execute_reply":"2026-09-06T16:45:03.703302Z"},"papermill":{"duration":44.025841,"end_time":"2026-09-06T16:45:03.70654+00:00","exception":false,"start_time":"2026-09-06T16:44:19.680699+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["industrial: 54,579 features\n","quarry: 20,863 features\n","farmland: 214,181 features\n","mineshaft: 1,017 features\n","adit: 3 features\n","power_infra: 119,686 features\n"]}],"source":["CATEGORY_TAGS = {\n","    \"industrial\": (\"landuse\", \"industrial\"),\n","    \"quarry\": (\"landuse\", \"quarry\"),\n","    \"farmland\": (\"landuse\", \"farmland\"),\n","    \"mineshaft\": (\"man_made\", \"mineshaft\"),\n","    \"adit\": (\"man_made\", \"adit\"),\n","    \"power_infra\": (\"power\", [\"plant\", \"substation\", \"generator\"]),\n","}\n","\n","# Keep the OSM features as fixed external reference data. Distances below are\n","# computed in the locked projected CRS. For polygon/line features the reference\n","# point is their EPSG:7755 centroid; this preserves the existing feature meaning\n","# while removing the prior CRS inconsistency.\n","h3_query_xy = np.column_stack([h3_gdf.geometry.centroid.x.values, h3_gdf.geometry.centroid.y.values])\n","\n","# h3_gdf is already in EPSG:7755 after the state-assignment cell.\n","assert str(h3_gdf.crs).upper() == PROJECT_CRS.upper()\n","\n","for name, (key, val) in CATEGORY_TAGS.items():\n","    if key not in osm_raw.columns:\n","        h3_gdf[f\"dist_osm_{name}_km\"] = np.nan\n","        h3_gdf[f\"n_osm_{name}_5km\"] = 0\n","        print(\n","            f\"{name}: tag key '{key}' not present in export — \"\n","            \"0 features, check the tags-filter step\"\n","        )\n","        continue\n","\n","    mask = osm_raw[key].isin(val) if isinstance(val, list) else osm_raw[key] == val\n","    sub = osm_raw[mask].copy()\n","    print(f\"{name}: {len(sub):,} features\")\n","\n","    sub_projected = sub.to_crs(PROJECT_CRS)\n","    rep = sub_projected.geometry.centroid\n","    ref_xy = np.column_stack([rep.x.values, rep.y.values])\n","\n","    h3_gdf[f\"dist_osm_{name}_km\"] = nearest_distance_km_projected(\n","        h3_query_xy, ref_xy\n","    )\n","    h3_gdf[f\"n_osm_{name}_5km\"] = count_within_radius_projected(\n","        h3_query_xy, ref_xy, radius_km=5.0\n","    )\n"]},{"cell_type":"markdown","id":"33d1acc0","metadata":{"papermill":{"duration":0.009575,"end_time":"2026-09-06T16:45:03.726538+00:00","exception":false,"start_time":"2026-09-06T16:45:03.716963+00:00","status":"completed"},"tags":[]},"source":["# Merge onto df_daily and save"]},{"cell_type":"code","execution_count":10,"id":"6dcaf9eb","metadata":{"execution":{"iopub.execute_input":"2026-09-06T16:45:03.746891Z","iopub.status.busy":"2026-09-06T16:45:03.746534Z","iopub.status.idle":"2026-09-06T16:45:08.907906Z","shell.execute_reply":"2026-09-06T16:45:08.906646Z"},"papermill":{"duration":5.174537,"end_time":"2026-09-06T16:45:08.910224+00:00","exception":false,"start_time":"2026-09-06T16:45:03.735687+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Saved. Final shape: (1442545, 64)\n"]}],"source":["h3_features = h3_gdf.drop(columns=\"geometry\")\n","assert h3_features[\"h3_08\"].is_unique\n","assert h3_features[\"state\"].notna().all()\n","n_before = len(df_d