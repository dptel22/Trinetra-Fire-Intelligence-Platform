, 12))\n","sns.heatmap(\n","    np.log1p(ranked.set_index(\"state\")[CLASS_COLS]),\n","    annot=ranked.set_index(\"state\")[CLASS_COLS],  # show real counts, color by log scale\n","    fmt=\".0f\",\n","    cmap=\"YlOrRd\",\n","    cbar_kws={\"label\": \"log(1 + cell count)\"},\n","    ax=ax,\n",")\n","ax.set_title(f\"Class evidence per state (threshold: {MIN_EVIDENCE} cells)\")\n","plt.tight_layout()\n","plt.savefig(\"/kaggle/working/state_class_heatmap.png\", dpi=150)\n","plt.show()"]},{"cell_type":"code","execution_count":14,"id":"b483c9a2","metadata":{"execution":{"iopub.execute_input":"2026-08-31T07:35:17.043059Z","iopub.status.busy":"2026-08-31T07:35:17.042339Z","iopub.status.idle":"2026-08-31T07:35:17.051245Z","shell.execute_reply":"2026-08-31T07:35:17.050415Z"},"papermill":{"duration":0.022976,"end_time":"2026-08-31T07:35:17.053005+00:00","exception":false,"start_time":"2026-08-31T07:35:17.030029+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["CLASS_COLS = [\"industrial_cells\", \"quarry_cells\", \"farmland_cells\", \"power_infra_cells\", \"flare_confirmed_cells\"]\n","MIN_EVIDENCE = 20\n","\n","def check_partition_support(train_states, testA_states, testB_states, summary,\n","                             class_cols=CLASS_COLS, min_train=100, min_test=30):\n","    \"\"\"Hard-constraint check against REAL counts. Does not choose states for you —\n","    plug in candidates and see if they actually survive.\"\"\"\n","    def totals(states):\n","        return summary[summary[\"state\"].isin(states)][class_cols].sum()\n","\n","    train_tot, testA_tot, testB_tot = totals(train_states), totals(testA_states), totals(testB_states)\n","    result = {\n","        \"train_ok\": bool((train_tot >= min_train).all()),\n","        \"testA_ok\": bool((testA_tot >= min_test).all()),\n","        \"testB_ok\": bool((testB_tot >= min_test).all()),\n","    }\n","    result[\"valid\"] = all(result.values())\n","\n","    for label, states, tot in [(\"train\", train_states, train_tot), (\"testA\", testA_states, testA_tot), (\"testB\", testB_states, testB_tot)]:\n","        print(f\"\\n{label}: {list(states)}\")\n","        print(tot.to_string())\n","    print(f\"\\nVALID: {result['valid']}\", result)\n","    return result"]},{"cell_type":"code","execution_count":15,"id":"20ae0220","metadata":{"execution":{"iopub.execute_input":"2026-08-31T07:35:17.076989Z","iopub.status.busy":"2026-08-31T07:35:17.076031Z","iopub.status.idle":"2026-08-31T07:35:17.089289Z","shell.execute_reply":"2026-08-31T07:35:17.088206Z"},"papermill":{"duration":0.027483,"end_time":"2026-08-31T07:35:17.091119+00:00","exception":false,"start_time":"2026-08-31T07:35:17.063636+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","train: ['Maharashtra', 'Karnataka', 'Madhya Pradesh', 'Punjab', 'Andhra Pradesh', 'Telangana']\n","industrial_cells      66028\n","quarry_cells          29229\n","farmland_cells        49540\n","power_infra_cells    120718\n","\n","testA: ['Gujarat', 'Tamil Nadu']\n","industrial_cells     13459\n","quarry_cells          3900\n","farmland_cells        6262\n","power_infra_cells    23224\n","\n","testB: ['Jharkhand', 'Rajasthan']\n","industrial_cells     6482\n","quarry_cells         5467\n","farmland_cells       1638\n","power_infra_cells    8690\n","\n","VALID: True {'train_ok': True, 'testA_ok': True, 'testB_ok': True, 'valid': True}\n"]}],"source":["# Gas flare has been folded into `industrial` (empirically non-viable as a\n","# standalone class — see threshold sweep: 5–12 WRI-confirmed cells nationally\n","# at best). Drop it from the partition support check accordingly.\n","CLASS_COLS_FINAL = [\"industrial_cells\", \"quarry_cells\", \"farmland_cells\", \"power_infra_cells\"]\n","\n","train_states = [\"Maharashtra\", \"Karnataka\", \"Madhya Pradesh\", \"Punjab\", \"Andhra Pradesh\", \"Telangana\"]\n","testA_states = [\"Gujarat\", \"Tamil Nadu\"]          # realistic / deployment-lik